# Build only Linksys MX4200 v1
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v1=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v2=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx5300=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx8500=n
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_zyxel_nbg7815=n

# WireGuard
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_rpcd-mod-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# OpenVPN with OpenSSL
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-proto-openvpn=y
